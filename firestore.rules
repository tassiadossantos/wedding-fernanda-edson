rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Guestbook: leitura pública, criação pública, atualização/exclusão negada
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // RSVP: leitura pública, criação pública, atualização/exclusão negada
    match /rsvp/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Gift Reservations: leitura pública, criação pública, atualização/exclusão negada
    match /gift_reservations/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Regra padrão: negar tudo o que não estiver definido acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}